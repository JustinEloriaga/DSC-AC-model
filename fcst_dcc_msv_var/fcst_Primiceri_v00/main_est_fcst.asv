close all
clear all

load data

y=data;
lags=2;
T0=40;
T0B=40;
T0A=[2 3];
T0H=4;
kB=.01;
kA=.1;
kH=.01;
M=600;
N=200;

% ---
% minchul
Yest = y(1:end-1,:);
Yact = y(end,:);
% ---

r=tvsvar(Yest,lags,T0,T0B,T0A,T0H,kB,kA,kH,M);

